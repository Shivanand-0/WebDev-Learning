<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>user data</title>
</head>
<body>
    <h2>Data of all users:</h2>
    <table border="2px">
        <tr>
            <th>ID</th>
            <th>User Name</th>
            <th>email</th>
        </tr>
        <% for(let i=0;i<result.length;i++){%>
        <tr>
            <td><%=result[i].id%></td>
            <td><%=result[i].username%></td>
            <td><%=result[i].email%></td>
            <td>
                <form method="post" action="/user/<%=result[i].id%>/edit">
                    <button>Edit</button>
                </form>
            </td>

        </tr>
    
    <%}%>
    </table>
</body>
</html>