<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit user</title>
</head>
<body>
    <form method="post" action="/user/<%=user[0].id%>?_method=PATCH">
        <h2>You are on edit page: </h2>
        <label for="uname">Edit your Username: </label>
        <textarea name="username" id="uname" cols="30" rows="1"><%=user[0].username%></textarea><br>
        <label for="pass">Password: </label>
        <input type="password" id="pass" name="pass" placeholder="Enter your password"><br>
        <button>Submit</button>
    </form>
</body>
</html>