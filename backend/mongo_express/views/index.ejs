<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>chat app</title>
    <link rel="stylesheet" href="index.css" />
  </head>
  <body>
    <h3>All chats</h3>

    <form action="/chats/new" method="post">
      <button>New Chat</button>
    </form>
    <br />
    <ul>
      <% for(chat of chats){%>
      <hr />
      <li>
        <div class="chat">
          <p>From:<%=chat.from%></p>
          <p>Recieved BY:<%=chat.to%></p>
          <div class="msg">
            <p>Message:<%=chat.msg%></p>
          </div>
          <p><%=chat.created_at.toString().split(" ")[4]%></p>
          <p><%=chat.created_at.toString().split(" ").slice(0,4)%></p>
          <div class="btns">
            <form method="get" action="/chats/<%=chat._id%>/edits">
              <button id="edit-btn">Edit</button>
            </form>
            <form method="post" action="/chats/<%=chat._id%>?_method=DELETE">
              <button id="delete-btn">Delete</button>
            </form>
          </div>
        </div>
      </li>
      <br />
      <%}%>
    </ul>
    <script src="popup.js"></script>
  </body>
</html>
