<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Your Message</title>
</head>
<body>
    <h3>Edit your chat</h3>
    <p> Chat id: <%=chat._id%></p>
    <p>This chat was sent from: <strong> <%=chat.from%> </strong> to: <strong> <%=chat.to%> </strong> </p>
    <form method="post" action="/chats/<%=chat._id%>?_method=PUT">
        <textarea name="msg" cols="20" rows="5"><%=chat.msg%></textarea>
        <br><button>Edit</button>
    </form>
</body>
</html>